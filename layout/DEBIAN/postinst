#!/bin/sh
# setuid для помощника: root-вкладки; запускается только приложением Terminal
chown root:wheel /var/jb/Applications/Terminal.app/mtsh 2>/dev/null
chmod 4755 /var/jb/Applications/Terminal.app/mtsh 2>/dev/null
if [ -x /var/jb/usr/bin/uicache ]; then /var/jb/usr/bin/uicache -p /var/jb/Applications/Terminal.app >/dev/null 2>&1 || true; fi
exit 0
